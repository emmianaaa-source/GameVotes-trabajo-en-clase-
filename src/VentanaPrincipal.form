<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="VentanaPrincipal">
  <grid id="27dc6" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="6" vgap="6">
    <margin top="8" left="8" bottom="8" right="8"/>
    <constraints>
      <xy x="10" y="10" width="980" height="620"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <tabbedpane id="10001" binding="tabbedPane">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <!-- TAB 1: CATALOGO Y REGISTRO (R1 y R2) -->
          <grid id="10002" binding="panelTab1" layout-manager="GridLayoutManager" row-count="2" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="8">
            <margin top="10" left="10" bottom="10" right="10"/>
            <constraints>
              <tabbedpane title="Catálogo"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="10101" class="javax.swing.JLabel" binding="lblTotal">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Total de videojuegos: 20"/>
                </properties>
              </component>
              <scrollpane id="10102">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="10103" class="javax.swing.JList" binding="listaCatalogo">
                    <constraints/>
                    <properties/>
                  </component>
                </children>
              </scrollpane>
              <grid id="10104" layout-manager="GridLayoutManager" row-count="7" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="6" vgap="8">
                <margin top="8" left="8" bottom="8" right="8"/>
                <constraints>
                  <grid row="0" column="1" row-span="2" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="etched" title="Nuevo Videojuego"/>
                <children>
                  <component id="10105" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Código:"/>
                    </properties>
                  </component>
                  <component id="10106" class="javax.swing.JTextField" binding="txtRegCodigo">
                    <constraints>
                      <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties/>
                  </component>
                  <component id="10107" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Nombre:"/>
                    </properties>
                  </component>
                  <component id="10108" class="javax.swing.JTextField" binding="txtRegNombre">
                    <constraints>
                      <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties/>
                  </component>
                  <component id="10109" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Estudio:"/>
                    </properties>
                  </component>
                  <component id="10110" class="javax.swing.JTextField" binding="txtRegEstudio">
                    <constraints>
                      <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties/>
                  </component>
                  <component id="10111" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Categoría:"/>
                    </properties>
                  </component>
                  <component id="10112" class="javax.swing.JComboBox" binding="cmbRegCategoria">
                    <constraints>
                      <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <model>
                        <item value="Acción"/>
                        <item value="Estrategia"/>
                        <item value="RPG"/>
                        <item value="Plataformas"/>
                        <item value="Simulación"/>
                      </model>
                    </properties>
                  </component>
                  <component id="10113" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Año:"/>
                    </properties>
                  </component>
                  <component id="10114" class="javax.swing.JTextField" binding="txtRegAnio">
                    <constraints>
                      <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties/>
                  </component>
                  <component id="10115" class="javax.swing.JButton" binding="btnRegistrar">
                    <constraints>
                      <grid row="5" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Registrar"/>
                    </properties>
                  </component>
                  <vspacer id="10116">
                    <constraints>
                      <grid row="6" column="0" row-span="1" col-span="2" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
                    </constraints>
                  </vspacer>
                </children>
              </grid>
            </children>
          </grid>

          <!-- TAB 2: BUSQUEDA LINEAL + BUSQUEDA BINARIA, EDICION, BORRAR Y VOTAR (R3, R4 y R5) -->
          <grid id="20001" binding="panelTab2" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="true" same-size-vertically="true" hgap="10" vgap="8">
            <margin top="10" left="10" bottom="10" right="10"/>
            <constraints>
              <tabbedpane title="Buscar y Editar"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <!-- SUBPANEL IZQUIERDO: BUSQUEDA DE TEXTO -->
              <grid id="20101" binding="panelIzq" layout-manager="GridLayoutManager" row-count="2" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="6" vgap="8">
                <margin top="8" left="8" bottom="8" right="8"/>
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="etched" title="Búsqueda por Texto (Nombre o Estudio)"/>
                <children>
                  <component id="20102" class="javax.swing.JTextField" binding="txtBuscarTexto">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties/>
