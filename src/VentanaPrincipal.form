                  </component>
                  <component id="20217" class="javax.swing.JButton" binding="btnGuardarCambios">
                    <constraints>
                      <grid row="7" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Guardar Cambios"/>
                    </properties>
                  </component>
                  <component id="20218" class="javax.swing.JButton" binding="btnEliminar">
