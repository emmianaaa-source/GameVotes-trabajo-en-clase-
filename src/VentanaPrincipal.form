                    </constraints>
                    <properties>
                      <text value="Buscar"/>
                    </properties>
                  </component>
                  <component id="20205" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Código:"/>
                    </properties>
                  </component>
                  <component id="20206" class="javax.swing.JTextField" binding="txtEditCodigo">
                    <constraints>
                      <grid row="1" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
