                    <properties>
                      <text value="Categoría:"/>
                    </properties>
                  </component>
                  <component id="20212" class="javax.swing.JComboBox" binding="cmbEditCategoria">
                    <constraints>
                      <grid row="4" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
